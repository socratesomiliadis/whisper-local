include Start.cmd Setup.ps1 package*.json
include components.json jsconfig.json vite.config.js
recursive-include requirements *.txt
recursive-include frontend *.jsx *.js *.css *.html
include CHANGELOG.md .editorconfig .gitattributes .gitignore .prettierignore
recursive-include docs *.json *.png *.md
recursive-include tests *.py *.cjs
recursive-include scripts *.py
recursive-include .github *.yml *.md
recursive-include src/whisper_local/static *.js *.css *.svg *.woff2 *.txt
recursive-include src/whisper_local/templates *.html
prune .runtime
prune .models
prune node_modules
prune test-results
global-exclude __pycache__ *.py[cod]
